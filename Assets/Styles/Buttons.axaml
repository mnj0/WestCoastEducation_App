<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
  <ResourceDictionary>
    <ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="/Assets/Resources/Color.axaml" />
    </ResourceDictionary.MergedDictionaries>
  </ResourceDictionary>
  </Styles.Resources>

  <Design.PreviewWith>
    <Border Background="{DynamicResource MainWindowBackground}" Padding="20">
      <!-- Add Controls for Previewer Here -->
       <Button Classes="PageSelectButton">
        <StackPanel Orientation="Horizontal">
          <Label Content="Hej Hejaa" />
        </StackPanel>
       </Button>
    </Border>
  </Design.PreviewWith>

  <!-- Add Styles Here -->
    <Style Selector="Button.PageSelectButton">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="Foreground" Value="{DynamicResource MainText}" />
      <Setter Property="Background" Value="{DynamicResource MainBackground}" />
      <Setter Property="CornerRadius" Value="50" />
      <Setter Property="Padding" Value="16,8" />
    </Style>

  <Style Selector="Button.PageSelectButton:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainHover}" />
    <Setter Property="Foreground" Value="{DynamicResource MainText}" />
  </Style>

  <Style Selector="Button.PageSelectButton:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource MainWindowBackground}" />
  </Style>

  <Style Selector="Button.RowAction">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource MainBackground}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource MainAccent}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="50" />
    <Setter Property="Padding" Value="12,4" />
  </Style>

  <Style Selector="Button.RowAction:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MainHover}" />
    <Setter Property="Foreground" Value="{DynamicResource MainBackground}" />
  </Style>

  <Style Selector="Button.RowAction:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainAccent}" />
    <Setter Property="Foreground" Value="{DynamicResource MainBackground}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource MainDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MainDanger}" />
  </Style>

  <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource MainDanger}" />
    <Setter Property="Foreground" Value="{DynamicResource MainWindowBackground}" />
  </Style>

  <Style Selector="Button.danger:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource MainDanger}" />
    <Setter Property="Foreground" Value="{DynamicResource MainWindowBackground}" />
  </Style>
</Styles>
