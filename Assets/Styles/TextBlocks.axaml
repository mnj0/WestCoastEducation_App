<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Design.PreviewWith>
    <Border Padding="20">
      <Design.PreviewWith>
        <Border Background="{DynamicResource MainWindowBackground}" Padding="20">
          <StackPanel>
            <TextBlock Classes="pageTitle" Text="Du är inne i admin appen" />
          </StackPanel>
        </Border>
      </Design.PreviewWith>
    </Border>
  </Design.PreviewWith>

    <Style Selector="TextBlock.pageTitle">
      <Setter Property="Foreground" Value="{DynamicResource MainBackground}" />
      <Setter Property="FontSize" Value="28" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="LetterSpacing" Value="-0.5" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>  
</Styles>
