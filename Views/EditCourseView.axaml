<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:WestCoastEducation_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducation_App.Views.EditCourseView"
             x:DataType="vm:EditCourseViewModel">

  <Design.DataContext>
    <vm:EditCourseViewModel />
  </Design.DataContext>

  <StackPanel>
    <TextBlock Classes="pageTitle" Text="{Binding PageTitle}" />

    <StackPanel Margin="0 30 0 0" HorizontalAlignment="Center">
      <Grid RowSpacing="12" ColumnSpacing="12" ColumnDefinitions="Auto,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
        <Label Classes="header" Grid.Row="0" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Id" />
        <Label Classes="header" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Titel" />
        <Label Classes="header" Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Antal Veckor" />
        <Label Classes="header" Grid.Row="3" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Start Datum" />
        <Label Classes="header" Grid.Row="4" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Slut Datum" />
        <Label Classes="header" Grid.Row="5" HorizontalAlignment="Right" VerticalAlignment="Center" Content="Typ Av Kurs" />

        <TextBox Classes="form" Grid.Column="1" Grid.Row="0" Text="{Binding ListNumber}" />
        <TextBox Classes="form" Grid.Column="1" Grid.Row="1" Text="{Binding Titel}" />
        <TextBox Classes="form" Grid.Column="1" Grid.Row="2" Text="{Binding HowManyWeeks}" />
        <TextBox Classes="form" Grid.Column="1" Grid.Row="3" Text="{Binding StartDate}" />
        <TextBox Classes="form" Grid.Column="1" Grid.Row="4" Text="{Binding EndDate}" />
        <TextBox Classes="form" Grid.Column="1" Grid.Row="5" Text="{Binding TypeOfCourse}" />
      </Grid>

      <StackPanel Spacing="20" Margin="0 30 0 0" Orientation="Horizontal" HorizontalAlignment="Center">
        <Button Classes="PageSelectButton" Content="Spara" Command="{Binding SaveCommand}" />
        <Button Classes="PageSelectButton" Content="Avbryt"
                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToCoursesCommand}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>



