<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:WestCoastEducation_App.Models"
             xmlns:vm="using:WestCoastEducation_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducation_App.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

  
  <Design.DataContext>
      <vm:CoursesViewModel></vm:CoursesViewModel>
  </Design.DataContext>

    <StackPanel>
      <TextBlock Classes="pageTitle" Text=""/>

      <Button HorizontalAlignment="Left" Classes="PageSelectButton" MaxWidth="300"
        Content="Lägg till Kurs"
        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).GoToAddCourseCommand}" />

      <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 50 0 5">
        <Grid ColumnDefinitions="200,120,140,140,160">
          <Label Classes="header" Content="Kurs" />
          <Label Classes="header" Grid.Column="1" Content="Antal Veckor" />
          <Label Classes="header" Grid.Column="2" Content="Start Datum" />
          <Label Classes="header" Grid.Column="3" Content="Slut Datum" />
          <Label Classes="header" Grid.Column="4" Content="Typ Av Kurs" />
      </Grid>
      </Border>
      <ItemsControl ItemsSource="{Binding Courses}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="200,120,140,140,160">
              <Label Classes="cell title" Content="{Binding Titel}" />
              <Label Classes="cell" Grid.Column="1" Content="{Binding HowManyWeeks}" />
              <Label Classes="cell" Grid.Column="2" Content="{Binding StartDate}" />
              <Label Classes="cell" Grid.Column="3" Content="{Binding EndDate}" />
              <Label Classes="cell" Grid.Column="4" Content="{Binding TypeOfCourse}" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
</UserControl>
