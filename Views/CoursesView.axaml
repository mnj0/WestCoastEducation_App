<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:WestCoastEducation_App.Models"
             xmlns:vm="using:WestCoastEducation_App.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducation_App.Views.CoursesView"
             x:DataType="vm:CoursesViewModel">

  
  <Design.DataContext>
      <vm:CoursesViewModel></vm:CoursesViewModel>
  </Design.DataContext>

    <StackPanel>
      <TextBlock Classes="pageTitle" Text="{Binding PageTitle}"/>

      <Border BorderBrush="White" BorderThickness="0 0 0 1" Padding="0 50 0 5">
        <Grid ColumnDefinitions="100,200,200,*,Auto,Auto" ShowGridLines="False">
          <Label Content="Kurs" />
          <Label Grid.Column="1" Content="Antal Veckor" />
          <Label Grid.Column="2" Content="Start Datum" />
          <Label Grid.Column="3" Content="Slut Datum" />
          <Label Grid.Column="4" Content="Typ Av Kurs" />
        </Grid>
      </Border>
      <ItemsControl ItemsSource="">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Grid ColumnDefinitions="100,200,200,*,Auto,Auto" ShowGridLines="False">
              <Label Content="{Binding }" />
              <Label Grid.Column="1" Content="" />
              <Label Grid.Column="2" Content="" />
              <Label Grid.Column="3" Content="" />
              <Label Grid.Column="3" Content="" />
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
</UserControl>
