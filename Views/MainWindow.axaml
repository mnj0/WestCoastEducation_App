<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WestCoastEducation_App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WestCoastEducation_App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/images/avalonia-logo.ico"
        Title="AdminApp"
        Background="{DynamicResource MainWindowBackground}"
        WindowDecorations="Full"
        ExtendClientAreaToDecorationsHint="False">
        
      <Panel>
        <Grid RowDefinitions="60,Auto,*">
          <Border Grid.Row="0" Background="{DynamicResource Panel}">
              <Grid ColumnDefinitions="150,*,150">
                  <Image Margin="8"
                        Source="avares://WestCoastEducation_App/Assets/images/avalonia-logo.ico" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                              HorizontalAlignment="Center" VerticalAlignment="Center">
                      <Button Classes="PageSelectButton" Content="Home" Command="{Binding GoToHomeCommand}" />
                      <Button Classes="PageSelectButton" Content="Courses" Command="{Binding GoToCoursesCommand}"/>
                      <Button Classes="PageSelectButton" Content="Students" />
                      <Button Classes="PageSelectButton" Content="Teachers" />
                  </StackPanel>
              </Grid>
          </Border>

          <ContentControl Grid.Row="2" Padding="20" Content="{Binding CurrentView}" />
        </Grid>
      </Panel>
</Window>