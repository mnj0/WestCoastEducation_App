<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="WestCoastEducation_App.Views.StudentsView">
            
            
             <Panel>
              <Grid RowDefinitions="Auto,Auto, Auto">
                <TextBlock Grid.Row="0" FontSize="40" Margin="0 125 0 0" Classes="pageTitle"
                          Text="Inne I 'Student View'" HorizontalAlignment="Center" />
                <TextBlock Grid.Row="1" FontSize="40" Classes="pageTitle"
                          Text="Det ska bara Klonas från " HorizontalAlignment="Center" />
                <TextBlock Grid.Row="2" FontSize="40" Classes="pageTitle"
                          Text="Course workflow " HorizontalAlignment="Center" />
              </Grid>
             </Panel>
</UserControl>
