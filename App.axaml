<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WestCoastEducation_App.App"
             xmlns:local="using:WestCoastEducation_App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
            <ResourceInclude Source="/Assets/Resources/Color.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="/Assets/Styles/Buttons.axaml" />
        <StyleInclude Source="/Assets/Styles/Labels.axaml" />
        <StyleInclude Source="/Assets/Styles/TextBlocks.axaml" />
        <StyleInclude Source="/Assets/Styles/TextBoxes.axaml" />
    </Application.Styles>
</Application>